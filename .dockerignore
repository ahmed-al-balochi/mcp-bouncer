# Keep the build context small and free of anything that is a secret, a local
# artifact, or not part of the running service. Entries reflect what is actually
# on disk in this repo, not a generic template.

# Python virtualenv: large, host-specific, and rebuilt inside the image anyway.
.venv/
.venv*/
venv/

# Git metadata: never needed at runtime, and history must not ride into a layer.
.git/
.gitignore

# Byte-code and caches: regenerated in the image; PYTHONDONTWRITEBYTECODE keeps
# the runtime from creating more.
__pycache__/
*.py[cod]
.pytest_cache/

# setuptools metadata dirs present on disk (both the current and the old name);
# stale, and regenerated by the install step.
*.egg-info/
mcp_bouncer.egg-info/
tool_gate.egg-info/

# Local databases: the SQLite files the local/dev runs create. The deployed
# image uses DynamoDB and must never inherit a stale local store.
*.db
*.db-journal
*.db-wal
*.db-shm

# Terraform: infrastructure code and, critically, state. State can contain
# sensitive values and has no business in an application image.
terraform/

# Local working documents: session handoff and carried findings. Scaffolding for
# building this, never a deliverable, and they hold account and domain specifics.
*.local.md

# Local secrets for the development token source, and any dotenv file.
tokens.json
.env

# The Dockerfile and its ignore file themselves.
Dockerfile
.dockerignore
